<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="body_interfaces" params="head_velocity:=false">
    <xacro:waist_interfaces/>
    <xacro:head_interfaces head_velocity="${head_velocity}"/>
  </xacro:macro>

  <xacro:macro name="waist_interfaces">
    <!-- 关节接口定义 -->
    <joint name="body_joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
       <state_interface name="effort"/>
    </joint>

    <joint name="body_joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
       <state_interface name="effort"/>
    </joint>

    <joint name="body_joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
       <state_interface name="effort"/>
    </joint>

    <joint name="body_joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
       <state_interface name="effort"/>
    </joint>

  </xacro:macro>

  <xacro:macro name="head_interfaces" params="head_velocity:=true">
    <joint name="head_joint1">
      <command_interface name="position"/>
      <xacro:if value="${head_velocity}"><command_interface name="velocity"/></xacro:if>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="head_joint2">
      <command_interface name="position"/>
      <xacro:if value="${head_velocity}"><command_interface name="velocity"/></xacro:if>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </xacro:macro>

  <xacro:macro name="stand_interfaces" params="lift_movable:=true">
    <xacro:if value="${lift_movable}">
      <!-- lift_joint: prismatic lift [m]; 0=down, increase=up, range [0, 0.29] -->
      <joint name="lift_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:if>

    <!-- body_joint1: rotate [rad]; body_joint2: pitch [rad] -->
    <joint name="body_joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="body_joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="head_joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="head_joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </xacro:macro>
</robot>
