<?xml version="1.0"?>
<robot name="FiveAges W2 Chassis" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:property name="PI" value="3.1415926535897931"/>

	<xacro:macro name="linkhou_s2" params="joints_movable:=true variant:='' collider:='simple'">
		<!-- 根据joints_movable参数设置关节类型 -->
		<xacro:if value="${joints_movable}">
			<xacro:property name="steer_joint_type" value="revolute"/>
			<xacro:property name="wheel_joint_type" value="continuous"/>
		</xacro:if>
		<xacro:unless value="${joints_movable}">
			<xacro:property name="steer_joint_type" value="fixed"/>
			<xacro:property name="wheel_joint_type" value="fixed"/>
		</xacro:unless>

		<xacro:property name="shell_mesh" value="meshes/linkhou_s2/shell_default.glb"/>
		<xacro:property name="battery_mesh" value="meshes/linkhou_s2/battery.glb"/>
		<xacro:if value="${variant == 'sinopec'}">
			<xacro:property name="shell_mesh" value="meshes/linkhou_s2/sinopec/shell_sinopec.glb"/>
			<xacro:property name="battery_mesh" value="meshes/linkhou_s2/sinopec/battery_sinopec.glb"/>
		</xacro:if>

		<link name="base_footprint"/>
		<joint name="base_footprint_joint" type="fixed">
			<parent link="base_footprint"/>
			<child link="base_link"/>
			<origin xyz="0 0 0.04"/>
		</joint>

		<link name="base_link"/>
		<joint name="base_link_mount" type="fixed">
			<parent link="base_link"/>
			<child link="chassis_base"/>
			<origin rpy="0 0 ${PI}"/>
		</joint>

		<link name="chassis_base">
			<inertial>
				<origin xyz="-0.010273 0.00026047 0.1315"/>
				<mass value="87.15"/>
				<inertia
						ixx="0.83411"
						ixy="-0.00032119"
						ixz="0.004604"
						iyy="1.4167"
						iyz="7.1643E-05"
						izz="1.7214"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/base_link.glb"/>
				</geometry>
			</visual>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/${shell_mesh}"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin xyz="0 0 0.15"/>
					<geometry>
						<box size="0.5 0.3 0.2"/>
					</geometry>
				</collision>
				<collision>
					<origin xyz="0 0.195 0.16"/>
					<geometry>
						<box size="0.66 0.16 0.3"/>
					</geometry>
				</collision>
				<collision>
					<origin xyz="0 -0.195 0.16"/>
					<geometry>
						<box size="0.66 0.16 0.3"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/base_link.glb"/>
					</geometry>
				</collision>
				<collision>
					<geometry>
						<mesh filename="file://$(find fiveages_w2_common_description)/${shell_mesh}"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<link name="rr_steer">
			<inertial>
				<origin xyz="-0.00067026 -0.024202 -0.061733"/>
				<mass value="0.65556"/>
				<inertia
						ixx="0.00076736"
						ixy="-1.7164E-08"
						ixz="-3.4992E-07"
						iyy="0.00058611"
						iyz="-0.00023947"
						izz="0.00052471"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/steer_link.glb" scale="1 -1 1"/>
				</geometry>
			</visual>
		</link>

		<joint name="rr_steer_joint" type="${steer_joint_type}">
			<origin xyz="-0.23072 -0.21738 0.166"/>
			<parent link="base_link"/>
			<child link="rr_steer"/>
			<xacro:if value="${joints_movable}">
				<axis xyz="0 0 1"/>
				<limit lower="-${PI}" upper="${PI}" effort="5" velocity="6.28"/>
			</xacro:if>
		</joint>

		<link name="rr_wheel">
			<inertial>
				<origin xyz="-9.5495E-06 -0.00099178 6.4755E-06"/>
				<mass value="1.2283"/>
				<inertia
						ixx="0.0020567"
						ixy="-3.2625E-08"
						ixz="-1.1187E-07"
						iyy="0.0037677"
						iyz="1.4797E-07"
						izz="0.0020568"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/wheel.glb" scale="1 -1 1"/>
				</geometry>
			</visual>
			<collision>
				<origin rpy="${PI/2.0} 0 0"/>
				<geometry>
					<cylinder radius="0.07" length="0.046"/>
				</geometry>
			</collision>
		</link>

		<joint name="rr_wheel_joint" type="${wheel_joint_type}">
			<origin xyz="-0.00071653 -0.003566 -0.136"/>
			<parent link="rr_steer"/>
			<child link="rr_wheel"/>
			<xacro:if value="${joints_movable}">
				<axis xyz="0 1 0"/>
			</xacro:if>
		</joint>

		<link name="rl_steer">
			<inertial>
				<origin xyz="0.00067026 0.024202 -0.061733"/>
				<mass value="0.65556"/>
				<inertia
						ixx="0.00076736"
						ixy="-1.7163E-08"
						ixz="3.4992E-07"
						iyy="0.00058611"
						iyz="0.00023947"
						izz="0.00052471"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/steer_link.glb"/>
				</geometry>
			</visual>
		</link>

		<joint name="rl_steer_joint" type="${steer_joint_type}">
			<origin xyz="-0.22928 0.21738 0.166"/>
			<parent link="base_link"/>
			<child link="rl_steer"/>
			<xacro:if value="${joints_movable}">
				<axis xyz="0 0 1"/>
				<limit lower="-${PI}" upper="${PI}" effort="5" velocity="6.28"/>
			</xacro:if>
		</joint>

		<link name="rl_wheel">
			<inertial>
				<origin xyz="-6.77013827887762E-06 0.000991778701903534 9.34293679251755E-06"/>
				<mass value="1.22832806539885"/>
				<inertia
						ixx="0.0020567891793888"
						ixy="1.48916704553435E-07"
						ixz="-1.10605927530389E-07"
						iyy="0.0037676756883782"
						iyz="-2.79953606372295E-08"
						izz="0.00205674185492585"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/wheel.glb"/>
				</geometry>
			</visual>
			<collision>
				<origin rpy="${PI/2.0} 0 0"/>
				<geometry>
					<cylinder radius="0.07" length="0.046"/>
				</geometry>
			</collision>
		</link>

		<joint name="rl_wheel_joint" type="${wheel_joint_type}">
			<origin xyz="0.00071653 0.003566 -0.136"/>
			<parent link="rl_steer"/>
			<child link="rl_wheel"/>
			<xacro:if value="${joints_movable}">
				<axis xyz="0 1 0"/>
			</xacro:if>
		</joint>

		<link name="fr_steer">
			<inertial>
				<origin xyz="-0.00067026 -0.024202 -0.061733"/>
				<mass value="0.65556"/>
				<inertia
						ixx="0.00076736"
						ixy="-1.7163E-08"
						ixz="-3.4992E-07"
						iyy="0.00058611"
						iyz="-0.00023947"
						izz="0.00052471"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/steer_link.glb" scale="1 -1 1"/>
				</geometry>
			</visual>
		</link>

		<joint name="fr_steer_joint" type="${steer_joint_type}">
			<origin xyz="0.22928 -0.21738 0.166"/>
			<parent link="base_link"/>
			<child link="fr_steer"/>
			<xacro:if value="${joints_movable}">
				<axis xyz="0 0 1"/>
				<limit lower="-${PI}" upper="${PI}" effort="5" velocity="6.28"/>
			</xacro:if>
		</joint>

		<link name="fr_wheel">
			<inertial>
				<origin xyz="-6.4606E-06 -0.00099178 9.5769E-06"/>
				<mass value="1.2283"/>
				<inertia
						ixx="0.0020567"
						ixy="2.462E-08"
						ixz="-6.9326E-08"
						iyy="0.0037677"
						iyz="1.4949E-07"
						izz="0.0020569"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/wheel.glb" scale="1 -1 1"/>
				</geometry>
			</visual>
			<collision>
				<origin rpy="${PI/2.0} 0 0"/>
				<geometry>
					<cylinder radius="0.07" length="0.046"/>
				</geometry>
			</collision>
		</link>

		<joint name="fr_wheel_joint" type="${wheel_joint_type}">
			<origin xyz="-0.00071653 -0.003566 -0.136"/>
			<parent link="fr_steer"/>
			<child link="fr_wheel"/>
			<xacro:if value="${joints_movable}">
				<axis xyz="0 1 0"/>
			</xacro:if>
		</joint>

		<link name="fl_steer">
			<inertial>
				<origin xyz="0.00067026110136939 0.024201895934192 -0.0617332783946613"/>
				<mass value="0.655558098590739"/>
				<inertia
						ixx="0.00076735828499042"
						ixy="-1.71633678730281E-08"
						ixz="3.49915403143955E-07"
						iyy="0.000586107112558297"
						iyz="0.000239471330998281"
						izz="0.000524706735782284"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/steer_link.glb"/>
				</geometry>
			</visual>
		</link>

		<joint name="fl_steer_joint" type="${steer_joint_type}">
			<origin xyz="0.23072 0.21738 0.166"/>
			<parent link="base_link"/>
			<child link="fl_steer"/>
			<xacro:if value="${joints_movable}">
				<axis xyz="0 0 1"/>
				<limit lower="-${PI}" upper="${PI}" effort="5" velocity="6.28"/>
			</xacro:if>
		</joint>

		<link name="fl_wheel">
			<inertial>
				<origin xyz="-8.3207E-06 0.00099179 8.0258E-06"/>
				<mass value="1.2283"/>
				<inertia
						ixx="0.0020568"
						ixy="1.515E-07"
						ixz="-9.5872E-08"
						iyy="0.0037677"
						iyz="-1.7122E-09"
						izz="0.0020567"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/meshes/linkhou_s2/wheel.glb"/>
				</geometry>
			</visual>
			<collision>
				<origin rpy="${PI/2.0} 0 0"/>
				<geometry>
					<cylinder radius="0.07" length="0.046"/>
				</geometry>
			</collision>
		</link>

		<joint name="fl_wheel_joint" type="${wheel_joint_type}">
			<origin xyz="0.00071653 -0.003566 -0.136"/>
			<parent link="fl_steer"/>
			<child link="fl_wheel"/>
			<xacro:if value="${joints_movable}">
				<axis xyz="0 1 0"/>
			</xacro:if>
		</joint>

		<link name="rr_lidar">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/robosense/airy.glb"/>
				</geometry>
			</visual>
		</link>

		<joint name="rr_lidar_joint" type="fixed">
			<origin xyz="0.221633 0.200715 0.325074" rpy="0 -${PI*15/180} ${PI}"/>
			<parent link="chassis_base"/>
			<child link="rr_lidar"/>
		</joint>

		<link name="fl_lidar">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/robosense/airy.glb"/>
				</geometry>
			</visual>
		</link>

		<joint name="fl_lidar_joint" type="fixed">
			<origin xyz="-0.221633 -0.200715 0.325074" rpy="0 -${PI*15/180} 0"/>
			<parent link="chassis_base"/>
			<child link="fl_lidar"/>
		</joint>

		<link name="chassis_camera">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/linkhou/ds51.glb"/>
				</geometry>
			</visual>
		</link>

		<joint name="chassis_camera_joint" type="fixed">
			<origin xyz="-0.3438 -0.00032028 0.159" rpy="${-PI/2} 0 ${PI/2}"/>
			<parent link="chassis_base"/>
			<child link="chassis_camera"/>
		</joint>

		<link name="chassis_left_battery">
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/${battery_mesh}"/>
				</geometry>
			</visual>
		</link>

		<joint name="chassis_left_battery" type="fixed">
			<origin xyz="0 -0.22709 0.20372" rpy="0 0 0"/>
			<parent link="chassis_base"/>
			<child link="chassis_left_battery"/>
		</joint>

		<link name="chassis_right_battery">
			<visual>
				<geometry>
					<mesh filename="file://$(find fiveages_w2_common_description)/${battery_mesh}"/>
				</geometry>
			</visual>
		</link>

		<joint name="chassis_right_battery" type="fixed">
			<origin xyz="0 0.22709 0.20372" rpy="0 0 ${PI}"/>
			<parent link="chassis_base"/>
			<child link="chassis_right_battery"/>
		</joint>

		<!-- Ultrasonic sensors C1-C8 (poses from S2_3DURDF, mesh: sensor_models/ultrasonic_02) -->
		<link name="ultrasonic_c1">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/ultrasonic/ultrasonic_02.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="ultrasonic_c1_joint" type="fixed">
			<origin xyz="-0.173908647658815 -0.272499999982074 0.188152" rpy="${PI/2} 0 0"/>
			<parent link="base_link"/>
			<child link="ultrasonic_c1"/>
		</joint>

		<link name="ultrasonic_c2">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/ultrasonic/ultrasonic_02.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="ultrasonic_c2_joint" type="fixed">
			<origin xyz="0.173974239740265 -0.2725 0.188152" rpy="${PI/2} 0 0"/>
			<parent link="base_link"/>
			<child link="ultrasonic_c2"/>
		</joint>

		<link name="ultrasonic_c3">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/ultrasonic/ultrasonic_02.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="ultrasonic_c3_joint" type="fixed">
			<origin xyz="0.32715024049647 -0.181305140670272 0.162362" rpy="1.57079615933824 0 1.23991700422271"/>
			<parent link="base_link"/>
			<child link="ultrasonic_c3"/>
		</joint>

		<link name="ultrasonic_c4">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/ultrasonic/ultrasonic_02.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="ultrasonic_c4_joint" type="fixed">
			<origin xyz="0.327150240494142 0.181305140677049 0.162362" rpy="1.57079615933824 0 1.90167564936708"/>
			<parent link="base_link"/>
			<child link="ultrasonic_c4"/>
		</joint>

		<link name="ultrasonic_c5">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/ultrasonic/ultrasonic_02.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="ultrasonic_c5_joint" type="fixed">
			<origin xyz="0.173974239740266 0.2725 0.188152" rpy="${PI/2} 0 ${PI}"/>
			<parent link="base_link"/>
			<child link="ultrasonic_c5"/>
		</joint>

		<link name="ultrasonic_c6">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/ultrasonic/ultrasonic_02.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="ultrasonic_c6_joint" type="fixed">
			<origin xyz="-0.173908647658814 0.272500000008966 0.188152" rpy="${PI/2} 0 ${-PI}"/>
			<parent link="base_link"/>
			<child link="ultrasonic_c6"/>
		</joint>

		<link name="ultrasonic_c7">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/ultrasonic/ultrasonic_02.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="ultrasonic_c7_joint" type="fixed">
			<origin xyz="-0.321194563015731 0.166 0.173165" rpy="${PI/2} 0 -1.72854667833684"/>
			<parent link="base_link"/>
			<child link="ultrasonic_c7"/>
		</joint>

		<link name="ultrasonic_c8">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/ultrasonic/ultrasonic_02.glb"/>
				</geometry>
			</visual>
		</link>
		<joint name="ultrasonic_c8_joint" type="fixed">
			<origin xyz="-0.321194563015517 -0.166 0.173165" rpy="${PI/2} 0 -1.41304597525296"/>
			<parent link="base_link"/>
			<child link="ultrasonic_c8"/>
		</joint>

	</xacro:macro>

</robot>
